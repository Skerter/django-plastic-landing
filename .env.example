# ════════════════════════════════════════════════════════════════════════════
# Dev environment template. Copy it to .env: `cp .env.example .env`.
# Every value is a placeholder. .env is in .gitignore; only this template is committed.
# ════════════════════════════════════════════════════════════════════════════

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.docker
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# The `db` host is the docker compose service name. It matches POSTGRES_* in compose.yaml.
DATABASE_URL=postgres://demoplast:demoplast@db:5432/demoplast

# --- Demo mode ---
# DEMO_MODE=True disables the real external calls (SMTP email, Telegram, amoCRM):
# the lead is saved to the database and the channels only log "demo, skipped".
# That is how the demo runs without a single real key. Use False for live mode.
DEMO_MODE=True

# --- Sentry (production) ---
SENTRY_DSN=

# --- Email ---
# The technical sender mailbox. USER and FROM usually match (some providers do not
# allow sending on behalf of another address). The notification recipient lives in
# the admin (SiteSettings.email_notifications), NOT here.
# In dev the emails are printed to the console (EMAIL_BACKEND in dev.py); with
# DEMO_MODE=True sending is never called at all.
DEFAULT_FROM_EMAIL=noreply@demoplast.example
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@demoplast.example
EMAIL_HOST_PASSWORD=change-me-app-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False

# --- Telegram ---
# The bot token for lead notifications. chat_id is set in the admin (SiteSettings).
TELEGRAM_BOT_TOKEN=

# --- amoCRM ---
# BASE_URL: https://<subdomain>.amocrm.ru. CLIENT_*/REDIRECT_URI come from the integration card.
# PIPELINE/STATUS are optional (empty = the first stage of the main pipeline).
# The first token pair is obtained with: manage.py amocrm_auth <code>
AMOCRM_BASE_URL=https://your-account.amocrm.ru
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://demoplast.example/amocrm/callback/
AMOCRM_PIPELINE_ID=0
AMOCRM_STATUS_ID=0
