# ════════════════════════════════════════════════════════════════════════════
# Environment of the online demo behind the shared Traefik.
# On the server: cp .env.example .env, then fill in SECRET_KEY + the database password.
# Do NOT commit .env.
# ════════════════════════════════════════════════════════════════════════════

# the compose project name (so it does not clash with other deploy/selectel/ stacks)
COMPOSE_PROJECT_NAME=demo-plast

# --- The domain for Traefik routing (read in compose.yaml as ${SITE_DOMAIN}) ---
# The host sits behind Cloudflare (proxied). TLS on the origin is issued by Traefik
# itself through Let's Encrypt, so the CF encryption mode must be Full or Full (Strict):
# on Flexible, SECURE_SSL_REDIRECT in prod.py produces an infinite redirect.
SITE_DOMAIN=demoplast.skerter.dev

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-50-char-random-secret
DEBUG=False
ALLOWED_HOSTS=demoplast.skerter.dev
# Behind an HTTPS proxy Django 5 requires a trusted origin for CSRF on POST forms.
CSRF_TRUSTED_ORIGINS=https://demoplast.skerter.dev

# --- Demo mode: the external integrations are never called, qcluster is not needed ---
DEMO_MODE=True

# --- Database (host = the db service name) ---
DATABASE_URL=postgres://demoplast:change-me-strong-password@db:5432/demoplast
POSTGRES_DB=demoplast
POSTGRES_USER=demoplast
POSTGRES_PASSWORD=change-me-strong-password

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Everything below is empty: unused with DEMO_MODE=True, but prod.py reads the env ---
DEFAULT_FROM_EMAIL=noreply@demo.example
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
TELEGRAM_BOT_TOKEN=
AMOCRM_BASE_URL=
AMOCRM_CLIENT_ID=0
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
AMOCRM_PIPELINE_ID=0
AMOCRM_STATUS_ID=0
